INSERT INTO licensing.application_payment (application_id, amount, payment_date, payment_status, accountant, iban, bic, ballot_period_id)
SELECT a.id, 3500, now(), 'paid'::licensing.payment_status, 'System', 'DE89370400440532013000', 'COBADEFFXXX', 1
FROM (SELECT id FROM licensing.application) a;

INSERT INTO licensing.ballot (ballot_period_id, application_id, selected) SELECT 1, a.id, false
FROM (SELECT id FROM licensing.application) a;
