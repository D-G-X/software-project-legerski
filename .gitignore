############################
# TEST DIRECTORIES AND FILES TO IGNORE ON MAIN BRANCH
############################

# Java / Spring tests
/license-application-service/src/test/

# Jest / frontend mocks (test-only)
/license-application-service/__mocks__/

# Java
**/*Test.java
**/*Tests.java

# JavaScript / TypeScript
**/*.test.js
**/*.test.jsx
**/*.test.ts
**/*.test.tsx

# Jest snapshots (falls vorhanden)
**/__snapshots__/

# MSW mocks (API mocks used only for tests)
**/*.msw.ts
**/*.msw.js
